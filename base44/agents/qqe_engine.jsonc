      "function_name": "qqeEngine",
      "description": "Generate a full QQE Daily Briefing with 14-factor scoring, regime template identification, cause-and-effect analysis, trade plan, and historical pattern matching"
    },
    {
      "function_name": "marketCauseEngine",
      "description": "Get real-time market cause scores, regime, and macro data for any symbol"
    }
  ]
