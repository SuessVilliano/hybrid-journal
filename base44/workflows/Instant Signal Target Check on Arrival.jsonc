{
  "name": "Instant Signal Target Check on Arrival",
  "description": "The moment a new signal arrives, immediately checks its price vs TP/SL for an instant hit detection (no waiting for the scheduled monitor).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Signal"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "instant_signal_target_check_on_arrival",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkNewSignal",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "checkNewSignal"
  }
}