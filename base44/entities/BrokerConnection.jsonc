{
  "name": "BrokerConnection",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "DXTrade",
        "cTrader",
        "MatchTrader",
        "Rithmic",
        "MT4",
        "MT5",
        "Tradovate",
        "TradeLocker",
        "NinjaTrader",
        "ThinkorSwim",
        "TradingView",
        "Binance",
        "Kraken",
        "Alpaca",
        "OANDA",
        "Public",
        "Other"
      ],
      "description": "Trading platform/broker (Kraken real-key connections set provider='Kraken')."
    },
    "mode": {
      "type": "string",
      "enum": [
        "READONLY_API",
        "EXECUTION_VIA_ICOPYTRADE",
        "WEBHOOK_PUSH",
        "STATEMENT_INGEST"
      ],
      "default": "STATEMENT_INGEST",
      "description": "Connection method"
    },
    "display_name": {
      "type": "string",
      "description": "User-friendly name for this connection"
    },
    "broker_id": {
      "type": "string",
      "description": "Internal broker slug used by the connection form / sync router (kraken, dxtrade, ctrader, ...)"
    },
    "broker_name": {
      "type": "string",
      "description": "Display name of the broker (e.g. Kraken, DXTrade) shown on the connection card"
    },
    "connection_type": {
      "type": "string",
      "description": "How this connection authenticates (api, credentials, dxtrade_login, tradovate_login, mcp, import_only)"
    },
    "account_number": {
      "type": "string",
      "description": "Trading account number / identifier"
    },
    "account_id": {
      "type": "string",
      "description": "Linked internal trading account id"
    },
    "external_connection_id": {
      "type": "string",
      "description": "Reference ID from iCopyTrade or external system"
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "degraded",
        "disconnected",
        "error",
        "pending",
        "manual"
      ],
      "default": "pending",
      "description": "Connection status"
    },
    "settings_json": {
      "type": "object",
      "description": "Non-sensitive connection settings and cached account snapshot (e.g. { broker_id: 'kraken', balance, equity, currency, validated_at })"
    },
    "secret_ref": {
      "type": "string",
      "description": "Reference to encrypted secrets (never store raw keys here)"
    },
    "api_key": {
      "type": "string",
      "description": "Encrypted API key (encrypted server-side via encryptBrokerKey before persisting)"
    },
    "api_secret": {
      "type": "string",
      "description": "Encrypted API secret (encrypted server-side via encryptBrokerKey before persisting)"
    },
    "username": {
      "type": "string",
      "description": "Login username (Tradovate / generic credentials)"
    },
    "password": {
      "type": "string",
      "description": "Login password (DXTrade / Tradovate) \u2014 store encrypted where possible"
    },
    "server": {
      "type": "string",
      "description": "Broker server / endpoint / environment"
    },
    "platform_url": {
      "type": "string",
      "description": "Platform URL for manual-import connections"
    },
    "platform_username": {
      "type": "string",
      "description": "Platform username for manual-import connections"
    },
    "mcp_url": {
      "type": "string",
      "description": "cTrader Remote MCP server URL (from cTrader Web \u2192 Remote MCP setup). Enables AI clients + in-app coach to read the account and trade from text."
    },
    "mcp_token": {
      "type": "string",
      "description": "Bearer token for the cTrader Remote MCP server."
    },
    "account_balance": {
      "type": "number",
      "description": "Last known account balance (account currency)"
    },
    "account_equity": {
      "type": "number",
      "description": "Last known account equity (account currency)"
    },
    "last_sync": {
      "type": "string",
      "format": "date-time",
      "description": "Last sync timestamp (used by the generic connection card)"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last successful Kraken gateway sync timestamp"
    },
    "sync_frequency_minutes": {
      "type": "number",
      "default": 60,
      "description": "Auto-sync interval in minutes"
    },
    "auto_sync_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Enable automatic syncing (Kraken gateway scheduled sync)"
    },
    "auto_sync": {
      "type": "boolean",
      "default": false,
      "description": "Enable auto-sync (form-facing flag, maps to auto_sync_enabled)"
    },
    "sync_interval": {
      "type": "number",
      "description": "Auto-sync interval in seconds (form-facing, maps to sync_frequency_minutes)"
    },
    "webhook_secret": {
      "type": "string",
      "description": "Secret for webhook signature verification"
    },
    "notes": {
      "type": "string",
      "description": "User notes for this connection"
    },
    "error_message": {
      "type": "string",
      "description": "Last error message if any"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}